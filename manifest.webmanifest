      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.wildlifewhisperer.fieldops",
      "id": "com.wildlifewhisperer.fieldops"
    }
  ],
  "prefer_related_applications": true,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
