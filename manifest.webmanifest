{
  "name": "Wildlife Whisperer FieldOps",
  "short_name": "FieldOps",
  "description": "Field operations management for wildlife removal professionals. Jobs, estimates, GPS, photos, and AI assistance — works offline.",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "browser"],
  "background_color": "#0a0a0f",
  "theme_color": "#808080",
  "orientation": "portrait-primary",
  "scope": ".",
  "id": "com.wildlifewhisperer.fieldops",
  "categories": ["business", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "assets/fieldops-icon.svg",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/fieldops-icon.svg",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/fieldops-icon.svg",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/fieldops-icon.svg",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
