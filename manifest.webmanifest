      "label": "Job list with search and filter capabilities"
    },
    {
      "src": "assets/screenshot-wide.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop view of the FieldOps dashboard"
    }
  ],
  "shortcuts": [
    {
      "name": "New Job",
      "short_name": "New Job",
      "description": "Create a new wildlife removal job",
      "url": "./index.html#/jobs/new",
      "icons": [
        {
          "src": "assets/fieldops-icon.svg",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "View job statistics and quick actions",
      "url": "./index.html#/",
      "icons": [
        {
          "src": "assets/fieldops-icon.svg",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Customers",
      "short_name": "Customers",
      "description": "View and manage customer list",
      "url": "./index.html#/customers",
      "icons": [
        {
          "src": "assets/fieldops-icon.svg",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Estimate Calculator",
      "short_name": "Estimate",
      "description": "Quick access to the estimate calculator",
      "url": "./index.html#/estimate",
      "icons": [
        {
          "src": "assets/fieldops-icon.svg",
          "sizes": "96x96",
          "type": "image/png"
        }
