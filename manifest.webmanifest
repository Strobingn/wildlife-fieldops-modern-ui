      "src": "assets/screenshot-dashboard.png",
      "sizes": "1170x2532",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Dashboard with job stats, weather, and quick actions"
    },
    {
      "src": "assets/screenshot-jobs.png",
      "sizes": "1170x2532",
      "type": "image/png",
