{
  "name": "wildlife-fieldops",
  "private": true,
  "version": "3.0.0",
  "description": "Field operations PWA for wildlife removal professionals. Offline-first with job management, estimates, GPS tracking, photos, and AI assistance.",
  "type": "module",
  "author": "Wildlife Whisperer LLC",
  "license": "UNLICENSED",
  "homepage": "https://wildlifewhispererllc.com/fieldops",
  "repository": {
    "type": "git",
    "url": "https://github.com/wildlife-whisperer/fieldops.git"
  },
  "bugs": {
    "url": "https://github.com/wildlife-whisperer/fieldops/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie <= 11",
    "chrome >= 100",
    "safari >= 15",
    "ios_saf >= 15"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "eslint src/ --ext .js,.mjs --report-unused-disable-directives --max-warnings=0",
    "lint:fix": "eslint src/ --ext .js,.mjs --fix",
    "format:check": "prettier --check \"src/**/*.{js,css,html,json}\"",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cap": "cap",
    "cap:android": "cap sync android && cap open android",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:assets": "echo 'Install @capacitor/assets manually'",
    "analyze": "vite build --mode analyze",
    "clean": "rm -rf dist/ node_modules/.vite/ android/app/build/"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/local-notifications": "^7.0.1",
    "@capacitor/network": "^7.0.1",
    "@capacitor/preferences": "^7.0.1",
    "@capacitor/push-notifications": "^7.0.1",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.1",
    "@capacitor/status-bar": "^7.0.1",
    "@supabase/supabase-js": "^2.56.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.4",
    "vite": "^7.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^5.12.0",
    "terser": "^5.36.0",
    "vitest": "^2.1.0"
  }
}
