# Wildlife FieldOps — Environment Variables
# ==========================================
#
# Copy this file to .env and fill in your API keys.
# Keys are ONLY used at build time. They never appear in the source code.
#
# GET YOUR KEYS — Step-by-step:
# https://github.com/Strobingn/wildlife-fieldops/blob/main/SETUP_GUIDE.md
#
# ==========================================

# --- SUPABASE (Database + Storage + Auth) ---
# Get these from: supabase.com → Your Project → Settings → API
# Project URL looks like: https://xxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_project_url_here
# Anon key looks like: eyJhbGciOiJIUzI1NiIs... (very long string)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- GOOGLE MAPS (GPS + Navigation) ---
# Get this from: console.cloud.google.com → APIs & Services → Credentials
# Key looks like: AIzaSyC... (starts with AIza)
GOOGLE_MAPS_API=your_google_maps_api_here
# Legacy alias also accepted by the native build:
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_here

# --- OPENWEATHER (Weather on job cards) ---
# Get this from: openweathermap.org → My Account → API Keys
# Optional — app works fine without it
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
