# Wildlife Whisperer FieldOps — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Maps JavaScript API
VITE_GOOGLE_MAPS_API=your-maps-api-key

# Google Calendar OAuth2
VITE_GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google API Key (for Calendar API discovery)
VITE_GOOGLE_API_KEY=your-google-api-key

# OpenWeatherMap
VITE_OPENWEATHER_API_KEY=your-openweather-key
